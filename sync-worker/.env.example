# This file belongs ONLY on the persistent private server, never in Vercel's frontend env.
APP_ORIGIN=https://your-app.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep in your server's secret manager and back it up separately from the encrypted volume.
SYNC_ENCRYPTION_KEY=
SYNC_DATA_DIR=/data
HOST=0.0.0.0
PORT=8787
