VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public HTTPS origin of the dedicated card-sync service; no secret here.
VITE_CARD_SYNC_URL=

# Server-side only. Used by the Vercel serverless function in api/gemini.ts.
# Do NOT prefix with VITE_, otherwise it will be exposed to the browser bundle.
GEMINI_API_KEY=your-gemini-api-key
# Optional server-only override for the current text model.
GEMINI_MODEL=gemini-3.5-flash-lite
